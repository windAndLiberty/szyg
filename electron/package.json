{
  "name": "szyg",
  "version": "1.0.0",
  "description": "szyg 智能矩阵运营系统",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.szyg.app",
    "productName": "szyg",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "../server/**/*",
      "../data/**/*",
      "../config.yaml"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "server",
        "filter": ["**/*"]
      },
      {
        "from": "../data",
        "to": "data"
      },
      {
        "from": "../server/szyg/storage/chromium",
        "to": "server/szyg/storage/chromium"
      }
    ],
    "win": {
      "target": "portable",
      "icon": null
    }
  },
  "devDependencies": {
    "electron": "^33.4.0",
    "electron-builder": "^25.0.0"
  }
}
