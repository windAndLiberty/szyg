CONTROL_DATABASE_URL=postgresql+psycopg://szyg:change-me@postgres:5432/szyg_control
CONTROL_PRODUCT_ID=szyg_private
CONTROL_JWT_SECRET=replace-with-at-least-32-random-characters
CONTROL_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
CONTROL_BOOTSTRAP_ADMIN_PASSWORD=replace-before-start
CONTROL_BOOTSTRAP_ADMIN_TOTP_SECRET=
CONTROL_PROVIDER_API_KEY=
CONTROL_PROVIDER_SPEECH_API_KEY=
CONTROL_PROVIDER_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ═══════ 火山视觉 CV 平台（OmniHuman1.5、主体检测）════════
# 开通 OmniHuman1.5：https://console.volcengine.com/ai/ability/detail/2
# AK/SK：火山引擎控制台 → 访问控制 → API 访问密钥 → 创建
# 必须使用 cn-north-1 region + Service=cv 进行 V4 签名
CONTROL_PROVIDER_CV_ACCESS_KEY=
CONTROL_PROVIDER_CV_SECRET_KEY=
CONTROL_PROVIDER_CV_BASE_URL=https://visual.volcengineapi.com
CONTROL_PROVIDER_CV_REGION=cn-north-1
# ═══════ 火山大模型录音文件识别（ASR）════════
# 开通录音文件识别（大模型）→ 控制台 → 语音技术 → 开通服务 → 创建 APP Key
# 资源 ID 固定为 volc.seedasr.auc（模型 2.0）
CONTROL_PROVIDER_ASR_APP_KEY=
CONTROL_PROVIDER_ASR_RESOURCE_ID=volc.seedasr.auc
CONTROL_PROVIDER_ASR_BASE_URL=https://openspeech.bytedance.com
CONTROL_GEO_OPENAI_API_KEY=
CONTROL_GEO_PERPLEXITY_API_KEY=
CONTROL_GEO_GEMINI_API_KEY=
CONTROL_PROVIDER_SPEECH_BASE_URL=https://openspeech.bytedance.com/api/v3/tts/create
# Read-only IAM credentials used only by the control worker for delayed bill reconciliation.
CONTROL_PROVIDER_BILLING_ACCESS_KEY=
CONTROL_PROVIDER_BILLING_SECRET_KEY=
CONTROL_PROVIDER_BILLING_REGION=cn-beijing
CONTROL_PROVIDER_BILLING_PROJECT=
CONTROL_CORS_ORIGINS=https://control.example.com
CONTROL_PUBLIC_BASE_URL=https://control.example.com
CONTROL_ALIPAY_APP_ID=
CONTROL_ALIPAY_MERCHANT_PRIVATE_KEY_FILE=/run/secrets/alipay_merchant_private_key.pem
CONTROL_ALIPAY_PUBLIC_KEY_FILE=/run/secrets/alipay_public_key.pem
CONTROL_ALIPAY_SELLER_ID=
CONTROL_ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
CONTROL_ALIPAY_NOTIFY_URL=https://control.example.com/api/v1/payments/alipay/notify
CONTROL_ALIPAY_RETURN_URL=https://control.example.com/api/v1/payments/alipay/return
CONTROL_SES_REGION=ap-hongkong
CONTROL_SES_SECRET_ID_FILE=/run/secrets/tencent_ses_secret_id
CONTROL_SES_SECRET_KEY_FILE=/run/secrets/tencent_ses_secret_key
CONTROL_SES_FROM_EMAIL=no-reply@notify.example.com
CONTROL_SES_TEMPLATE_ID=0
CONTROL_REFERENCE_TEMP_DIR=/app/data/reference_uploads
CONTROL_REFERENCE_TTL_HOURS=24
CONTROL_REFERENCE_MAX_MB=200
CONTROL_ACCESS_TOKEN_MINUTES=15
CONTROL_REFRESH_TOKEN_DAYS=30
CONTROL_OFFLINE_LICENSE_DAYS=7
CONTROL_OFFLINE_LICENSE_PRIVATE_KEY_FILE=/run/secrets/offline_license_private_key
CONTROL_OFFLINE_LICENSE_PUBLIC_KEY_FILE=/run/secrets/offline_license_public_key
CONTROL_DEFAULT_DEVICE_LIMIT=2
CONTROL_DEFAULT_ENTITLEMENT_DAYS=30
# 统一计费（方案B）：每位用户开通 credits 时的默认赠送额度（credits 数，0 表示不赠送、需手动充值）
CONTROL_LOG_PROMPT_CONTENT=false
CONTROL_ENVIRONMENT=production

# Capability aliases. Values may be a model ID or an inference endpoint ID.
MODEL_TEXT_FAST=
MODEL_TEXT_VISION=
MODEL_TEXT_REASONING=
MODEL_IMAGE_STANDARD=
MODEL_VIDEO_STANDARD=
MODEL_VIDEO_PRESENTER=
MODEL_VIDEO_OMNIHUMAN=jimeng_realman_avatar_picture_omni_v15
# 主体检测 req_key（OmniHuman 多主体场景用于 mask_url）
MODEL_SUBJECT_DETECTION=jimeng_realman_avatar_object_detection
MODEL_SPEECH_TTS=seed-audio-1.0
MODEL_SPEECH_ASR=volc.seedasr.auc
MODEL_EMBEDDING_STANDARD=
MODEL_GEO_DOUBAO=doubao-seed-2-0-lite-260428
MODEL_GEO_OPENAI=gpt-5-mini
MODEL_GEO_PERPLEXITY=sonar
MODEL_GEO_GEMINI=gemini-2.5-flash
