    {
      "id": "r003",
      "category": "research",
      "scenario": "热点追踪",
      "prompt": "帮我搜索一下今天有哪些和'AI营销'相关的热点新闻。然后基于最热的话题，帮我快速生成一篇蹭热点的短文，发布到全平台。这个要快，半小时内完成。",
      "test_target": ["tech_news_search", "pub_ai_generate", "platform_publish_direct"],
      "complexity": "high"
    },
    {
      "id": "e001",
      "category": "stress_test",
      "scenario": "全栈压力测试",
      "prompt": "帮我做以下事情：1. 检查所有平台的登录状态；2. 生成5条不同主题的AI营销文案；3. 把其中的3条审核通过并定时明天发布；4. 把剩下的2条发到微信朋友圈；5. 最后生成本周的工作报告。这是一个完整的营销日流程。",
      "test_target": ["platform_health", "pub_ai_generate", "pub_approve", "pub_schedule", "platform_publish_direct", "skill_docx_create"],
      "complexity": "max"
    },
    {
      "id": "e002",
      "category": "stress_test",
      "scenario": "多渠道并发",
      "prompt": "帮我同时启动以下任务：发布一篇小红书笔记、在微信朋友圈发一条促销信息、在B站上传一个视频脚本草稿、生成本月数据报表Excel、检查所有平台健康状态。这些任务互不依赖，可以并行处理。",
      "test_target": ["platform_publish_direct", "skill_xlsx_create", "platform_health"],
