      "test_target": ["video_mix_audio", "video_add_title"],
      "complexity": "medium"
    },
    {
      "id": "o001",
      "category": "office_skills",
      "scenario": "合同生成",
      "prompt": "帮我起草一份自媒体内容代运营合同。甲方是我们公司，乙方是内容创作者。包含服务范围、交付标准、付款方式、违约责任等条款。生成Word文档。",
      "test_target": ["skill_docx_create"],
      "complexity": "medium"
    },
    {
      "id": "o002",
      "category": "office_skills",
      "scenario": "数据报表",
      "prompt": "帮我生成一份本月各平台发布数据对比表。行是平台（抖音/小红书/B站/快手/微信），列是发布数、点赞数、评论数、分享数。数据填一些示例值。输出Excel文件。",
      "test_target": ["pub_stats", "skill_xlsx_create"],
      "complexity": "low"
    },
    {
      "id": "o003",
      "category": "office_skills",
      "scenario": "企划书",
      "prompt": "帮我写一份'2026年第三季度内容营销企划书'，做成PPT。包含：上季度回顾、市场趋势、本季度目标、内容策略、执行计划、预算估算。每页有标题和3-5个要点。",
      "test_target": ["skill_pptx_create"],
      "complexity": "high"
    },
    {
      "id": "r001",
      "category": "research",
      "scenario": "行业调研",
      "prompt": "帮我做一个深度研究：2026年中国短视频行业的AI应用趋势。需要包括：市场规模数据、头部平台（抖音/快手/B站/视频号）的AI功能对比、典型案例、未来预测。最后输出一份结构化报告。",
      "test_target": ["deep_research", "kb_ingest"],
      "complexity": "high"
