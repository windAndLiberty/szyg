{
  "version": "1.0",
  "description": "szyg 超级AI员工 — 业务提示词库。按中小企业的真实营销场景设计，用以测试 Hermes Agent 的各子系统调度能力。",
  "categories": {
    "content_creation": "内容创作",
    "platform_publishing": "平台发布",
    "private_domain": "私域运营",
    "public_domain": "公域获客",
    "marketing_automation": "营销自动化",
    "data_reporting": "数据分析",
    "creative_work": "创意工坊",
    "office_skills": "办公技能",
    "research": "深度研究"
  },
  "prompts": [
    {
      "id": "c001",
      "category": "content_creation",
      "scenario": "新媒体运营日常",
      "prompt": "帮我写一篇小红书种草笔记，推荐一款适合夏天用的防晒霜。要加上 emoji 和热门话题标签，语气要亲切像闺蜜聊天，控制在800字以内。写完之后直接发布到小红书。",
      "test_target": ["pub_create", "pub_submit", "pub_approve", "platform_publish_direct"],
      "complexity": "medium"
    },
    {
      "id": "c002",
      "category": "content_creation",
      "scenario": "B站视频脚本",
      "prompt": "我要做一个B站科技类视频，主题是'2026年最值得买的5款AI硬件'。帮我写一个完整的视频脚本，包括开场白、每款产品的介绍（ChatGPT耳机、AI眼镜、智能戒指等）、结尾引导关注的话术。时长控制在8分钟。写完后发布到B站。",
      "test_target": ["pub_ai_generate", "pub_create", "platform_publish"],
      "complexity": "high"
    },
    {
