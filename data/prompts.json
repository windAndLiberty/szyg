      "scenario": "每周数据周报",
      "prompt": "帮我生成本周的内容发布周报。需要包含：各平台发布数量、审核通过率、最受欢迎的内容TOP3、各平台数据对比。做成一个Excel表格。",
      "test_target": ["pub_stats", "pub_logs", "skill_xlsx_create"],
      "complexity": "medium"
