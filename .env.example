# ╔══════════════════════════════════════════════════════════════╗
# ║   「域灵」数字员工系统 — 环境变量模板                        ║
# ╚══════════════════════════════════════════════════════════════╝
#
# 复制此文件为 .env 并填入实际的 key:
#   cp .env.example .env
#
# 加载方式: config.yaml 中的 ${VAR} 会自动读取

# LLM — OpenRouter (免费模型可用)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# https://openrouter.ai/keys

# LLM — ModelScope (DeepSeek-V4, Qwen 等)
MODELSCOPE_API_KEY=ms-your-key-here
# https://modelscope.cn → 个人中心 → API Key

# 图像生成 — DashScope (qwen-image-plus 免费)
DASHSCOPE_API_KEY=sk-your-key-here
# https://dashscope.console.aliyun.com/apiKey

# 自托管 — LiteLLM (可选)
LITELLM_API_KEY=

# =============================================================================
# 火山引擎 — 字节跳动云与AI平台 (推荐，替代本地资源)
# =============================================================================
# 火山方舟 LLM API Key (OpenAI 兼容)
# https://console.volcengine.com/ark
VOLCANO_ENGINE_API_KEY=

# 火山引擎语音服务 (TTS + ASR)
# https://console.volcengine.com/speech/app
VOLCANO_SPEECH_APP_ID=
VOLCANO_SPEECH_TOKEN=

# API 服务认证 (可选, 空=不校验)
YULING_API_KEY=

# Wechaty 微信 (可选)
WECHATY_TOKEN=
WECHATY_ENDPOINT=
